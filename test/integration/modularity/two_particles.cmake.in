##
# Comparison of simulations of mixture using two particle instances and one particle instance
#

set(CMAKE_MODULE_PATH "@HALMD_TEST_CMAKE_BINARY_DIR@")
include(execute_halmd)

set(OUTPUT_PREFIX "@CMAKE_CURRENT_BINARY_DIR@/equilibration")
set(HALMD_WITH_GPU @HALMD_WITH_GPU@)

# Path to the comparison script 
set(COMPARE_PY "@CMAKE_SOURCE_DIR@/test/integration/modularity/compare_h5md.py")
if(NOT EXISTS "${COMPARE_PY}")
  set(COMPARE_PY "@CMAKE_CURRENT_BINARY_DIR@/compare_h5md.py")
endif()

# Outputs produced above
set(FILE_ONE "${OUTPUT_PREFIX}_one_particle.h5")
set(FILE_TWO "${OUTPUT_PREFIX}_two_particles.h5")


find_package(Python3 COMPONENTS Interpreter REQUIRED)


if(DEFINED USE_HOST)
  if(HALMD_WITH_GPU)
    set(BACKEND_OPTION "--disable-gpu")
  endif()
  message(STATUS "Using host backend")
else()
  message(STATUS "Using GPU backend")
endif()

if(NOT DEFINED DIMENSION)
  message(FATAL_ERROR "Variable DIMENSION undefined")
else()
  message(STATUS "Space dimension: ${DIMENSION}")
endif()

# prepare system state
execute_halmd(
  "${BACKEND_OPTION}"
  "@CMAKE_SOURCE_DIR@/test/integration/modularity/equilibration.lua"
  --verbose
  --output "${OUTPUT_PREFIX}"
  --dimension "${DIMENSION}"
  --particles 300,1
  --time 10
  --sampling trajectory=50
)

execute_halmd(
  "${BACKEND_OPTION}"
  "@CMAKE_SOURCE_DIR@/test/integration/modularity/two_particles_instances.lua"
  --verbose
  --output "${OUTPUT_PREFIX}_two_particles"
  --input "${OUTPUT_PREFIX}.h5"
  --time 1
  --sampling trajectory=100 state-vars=19 
)
execute_halmd(
  "${BACKEND_OPTION}"
  "@CMAKE_SOURCE_DIR@/test/integration/modularity/one_particle_instance.lua"
  --verbose
  --output "${OUTPUT_PREFIX}_one_particle"
  --input "${OUTPUT_PREFIX}.h5"
  --time 1
  --sampling trajectory=100 state-vars=19 
)

# Sanity checks before running Python
if(NOT EXISTS "${COMPARE_PY}")
  message(FATAL_ERROR "compare_h5md.py not found at: ${COMPARE_PY}")
endif()

if(NOT EXISTS "${FILE_ONE}" OR NOT EXISTS "${FILE_TWO}")
  message(FATAL_ERROR "Expected output files not found: ${FILE_ONE} / ${FILE_TWO}")
endif()

# Run numeric check (no plots in CI; remove --no-plot locally to see figures)
message(STATUS
  "Running: ${Python3_EXECUTABLE} ${COMPARE_PY} ${FILE_ONE} ${FILE_TWO} --tol 1e-2 --no-plot")
execute_process(
  COMMAND "${Python3_EXECUTABLE}" "${COMPARE_PY}" "${FILE_ONE}" "${FILE_TWO}" --tol 1e-2 --no-plot
  RESULT_VARIABLE COMPARE_RV
  OUTPUT_VARIABLE COMPARE_OUT
  ERROR_VARIABLE  COMPARE_ERR
)

# Print script output to the CMake log
message(STATUS "compare_h5md.py stdout:\n${COMPARE_OUT}")
if (NOT COMPARE_RV EQUAL 0)
  message(FATAL_ERROR "compare_h5md.py exited with ${COMPARE_RV}.")
endif()

# Cleanup
file(REMOVE
  "${OUTPUT_PREFIX}.h5"
  "${OUTPUT_PREFIX}.log"
  "${OUTPUT_PREFIX}_one_particle.log"
  "${OUTPUT_PREFIX}_one_particle.h5"
  "${OUTPUT_PREFIX}_two_particles.log"
  "${OUTPUT_PREFIX}_two_particles.h5"
)
