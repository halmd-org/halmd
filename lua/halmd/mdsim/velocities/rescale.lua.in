local log               = require("halmd.io.log")
local utility           = require("halmd.utility")
local module            = require("halmd.utility.module")

---
-- Rescale velocities
-- ==================
--
-- This module rescales particle velocities such that the total energy of each
-- particle matches the given target value.
--
-- The rescaling is applied according to the following procedure:
--
-- 1. Compute the total potential energy:
--
--    .. math::
--        E_\text{pot} = \sum_i U_i
--
--    where :math:`U_i` is the potential energy of particle :math:`i`.
--
-- 2. Compute the current total kinetic energy (assuming mass = 1):
--
--    .. math::
--        E_\text{kin} = \sum_i \frac{1}{2} |\vec{v}_i|^2
--
-- 3. Compute the scaling factor:
--
--    .. math::
--        \lambda = \sqrt{\frac{E_\text{target} - E_\text{pot}}{E_\text{kin}}}
--
-- 4. Apply the scaling:
--
--    .. math::
--        \vec{v}_i \gets \lambda \vec{v}_i
--
-- This operation conserves the direction of velocities but adjusts their magnitude
-- to satisfy the energy constraint.
--

--  C++ module binding
local rescale = assert(libhalmd.mdsim.velocities.rescale)

---
-- Construct rescale module.
--
-- :param table args: keyword arguments
-- :param args.particle: instance of :class:`halmd.mdsim.particle`
-- :param number args.target_energy: desired total energy (kinetic + potential)
--
-- .. method:: set()
--
--    Rescale particle velocities.
--
-- .. attribute:: target_energy
--
--    Target total energy (modifiable).
--

local M = module(function(args)
    local particle      = utility.assert_kwarg(args, "particle")
    local target_energy = utility.assert_kwarg(args, "target_energy")

    local label  = assert(particle.label)
    local logger = log.logger({label = ("rescale (%s)"):format(label)})

    -- Construct and return C++ instance
    return rescale(particle, target_energy, logger)
end)

return M
