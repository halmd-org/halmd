local clock             = require("halmd.mdsim.clock")
local core              = require("halmd.mdsim.core")
local log               = require("halmd.io.log")
local module            = require("halmd.utility.module")
local profiler          = require("halmd.utility.profiler")
local random            = require("halmd.random")
local utility           = require("halmd.utility")

---
-- Brownian dynamics via Euler-Maruyama scheme
-- ===========================================
--
-- This module implements an integrator for (fully overdamped) Brownian
-- dynamics of spherical particles, using the Euler–Maruyama scheme:
--
-- .. math::
--
--    \vec R_i(t + \tau) = \vec R_i(t) + (D_i / k_B T) \vec F_i(t) \tau
--    + \sqrt{2 D_i \tau\,} \, \vec N_i
--
-- where :math:`\vec R_i(t)` and :math:`\vec F_i(t)` are the position and force
-- vectors of particle :math:`i` at time :math:`t`, :math:`D_i` is its
-- diffusion constant, and the :math:`\vec N_i` are independent random vectors,
-- normally distributed with unit variance. The temperature of the (virtual)
-- solvent is :math:`T` and :math:`\tau` is the timestep.
--
-- .. note::
--
--    This implementation does not include motion due to particle velocities.
--

-- grab C++ wrappers
local brownian_euler = assert(libhalmd.mdsim.integrators.brownian_euler)

---
-- Construct Brownian integrator
--
-- :param table args: keyword arguments
-- :param args.particle: instance of :class:`halmd.mdsim.particle`
-- :param args.box: instance of :class:`halmd.mdsim.box`
-- :param number args.timestep: integration timestep (defaults to :attr:`halmd.mdsim.clock.timestep`)
-- :param table args.diffusion: vector with diffusion constants :math:`D_i` per species
-- :param number args.temperature: solvent temperature
--
-- .. method:: set_timestep(timestep)
--
--    Set integration time step in MD units.
--
--    :param number timestep: integration timestep
--
--    This method forwards to :meth:`halmd.mdsim.clock.set_timestep`,
--    to ensure that all integrators use an identical time step.
--
-- .. method:: set_temperature(temperature)
--
--    Set solvent temperature.
--
--    :param number temperature: temperature value
--
-- .. attribute:: timestep
--
--    Integration time step.
--
-- .. attribute:: diffusion
--
--    Diffusion constants :math:`D_i` for each particle species.
--
-- .. attribute:: temperature
--
--    Solvent temperature (acting as a heat bath).
--
-- .. method:: disconnect()
--
--    Disconnect integrator from core and profiler.
--
-- .. method:: integrate()
--
--    Perform the integration step and update particle positions. By default,
--    this function is connected to :meth:`halmd.mdsim.core.on_integrate`.
--
local M = module(function(args)
    local particle = utility.assert_kwarg(args, "particle")
    local box = utility.assert_kwarg(args, "box")
    local temperature = utility.assert_type(utility.assert_kwarg(args, "temperature"), "number")
    local diffusion = utility.assert_type(utility.assert_kwarg(args, "diffusion"), "table")
    local timestep = args.timestep
    if timestep then
        clock:set_timestep(timestep)
    else
        timestep = assert(clock.timestep)
    end
    local rng = random.generator({memory = particle.memory})
    local logger = log.logger({label = "brownian_euler"})

    -- construct instance
    local self = brownian_euler(particle, rng, box, timestep, temperature, diffusion, logger)

    -- capture C++ method set_timestep
    local set_timestep = assert(self.set_timestep)
    -- forward Lua method set_timestep to clock
    self.set_timestep = function(self, timestep)
        return clock:set_timestep(timestep)
    end

    -- sequence of signal connections
    local conn = {}
    self.disconnect = utility.signal.disconnect(conn, "integrator")

    -- connect integrator to core and profiler
    table.insert(conn, clock:on_set_timestep(function(timestep) set_timestep(self, timestep) end))
    table.insert(conn, core:on_integrate(function() self:integrate() end))

    local runtime = assert(self.runtime)
    table.insert(conn, profiler:on_profile(runtime.integrate, "Brownian integration step"))

    return self
end)

return M
